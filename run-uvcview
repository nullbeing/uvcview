#!/bin/sh
set -eu

FB=/dev/fb_lcd
KBD=/dev/input/by-path/platform-3f804000.i2c-event

set -- -d "$FB" "$@"
if [ -e "$KBD" ]; then
    set -- "$@" -k "$KBD"
fi

if [ "$(id -u)" -eq 0 ]; then
    exec /usr/local/bin/uvcview "$@"
elif sudo -n /usr/local/bin/uvcview -h >/dev/null 2>&1; then
    exec sudo -n /usr/local/bin/uvcview "$@"
else
    # Run unprivileged. The app will show a readable USB access error
    # dialog instead of disappearing immediately.
    exec /usr/local/bin/uvcview "$@"
fi
