#!/bin/sh
set -eu

# APPLaunch starts external apps as the desktop user (pi). USB access is
# granted by 99-uvcview.rules (0660, group plugdev), so no root/sudo needed.
FB=/dev/fb_lcd
[ -e "$FB" ] || FB=/dev/fb0
KBD=/dev/input/by-path/platform-3f804000.i2c-event

set -- -d "$FB" "$@"
if [ -e "$KBD" ]; then
    set -- "$@" -k "$KBD"
fi

exec /usr/local/bin/uvcview "$@"
